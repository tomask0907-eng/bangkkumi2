{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60,
      "includeFiles": "vendor/bangbom-chat/{package.json,src/**,server/**}"
    }
  },
  "rewrites": [
    {
      "source": "/backend/:path*",
      "destination": "https://bangbom-api.vercel.app/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/backend/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
